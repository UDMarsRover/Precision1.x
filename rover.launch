<launch>

    <!-- Start Main Service for the Rover, will kill all nodes if it dies-->
    <node pkg="rover_pkg" type="main.py" name="main" required="true" />

    <!-- Start Motor Control Node and have it restart if it dies-->
    <node pkg="rosserial_arduino" type="serial_node.py" name="motor_arduino" respawn="true">
        <param name="port" value="/dev/ttyACM0"/>
        <param name="baud" value="115200"/>
    </node>

    <!-- Start Motor Control Node and have it restart if it dies-->
    <node pkg="rosserial_arduino" type="serial_node.py" name="emo_arduino" respawn="true">
        <param name="port" value="/dev/ttyACM1"/>
        <param name="baud" value="57600"/>
    </node>

    <!-- Camera Server-->
    <node pkg="rover_pkg" type="camera_server.py" name="camera" required="true" />

    <!-- Lidar Startup-->
    <node name="rplidarNode"          pkg="rover_lidar"  type="rplidarNode" output="screen">
        <param name="serial_port"         type="string" value="/dev/ttyUSB0"/>
        <param name="serial_baudrate"     type="int"    value="115200"/>
        <param name="frame_id"            type="string" value="laser"/>
        <param name="inverted"            type="bool"   value="false"/>
        <param name="angle_compensate"    type="bool"   value="true"/>
    </node>

</launch>
