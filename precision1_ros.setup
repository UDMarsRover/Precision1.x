#!/bin/bash

if [ "$UDMRT_SETUP" != "2" ]
then
    sudo apt-get update -y 

    sudo apt-get upgrade -y

    sudo sh -c 'echo "deb http://packages.ros.org/ros/ubuntu $(lsb_release -sc) main" > /etc/apt/sources.list.d/ros-latest.list'

    sudo apt install curl # if you haven't already installed curl

    curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | sudo apt-key add -

    sudo apt update -y

    sudo apt install -y ros-noetic-desktop-full


    echo "source /opt/ros/noetic/setup.bash" >> /home/udmrt/.bashrc
    source /home/udmrt/.bashrc

    sudo apt install -y python3-rosdep python3-rosinstall python3-rosinstall-generator python3-wstool build-essential
    sudo apt install -y python3-rosdep

    sudo rosdep init
    rosdep update

    sudo apt-get install -y ros-noetic-rosserial ros-noetic-rosserial-arduino

    sudo apt-get install python3-pip python3-venv -ys
    ls .. | echo
    source /home/udmrt/p1x/bin/activate
    pip install --upgrade pip
    pip install -r packages.txt
fi


# Check to make sure we did not already write to these files
if [ "$UDMRT_SETUP" != "1" ]
then
echo "Setting up .bashrc ..."
echo "source /home/udmrt/p1x/bin/activate" >> ~/.bashrc
echo "source /opt/ros/noetic/setup.bash" >> ~/.bashrc
echo "cd /mnt/hgfs/Precision1.x" >> ~/.bashrc

# Setup sudoers config file to allow a shutdown from the udmrt account without a password
echo "Setting up sudoers ..."
sudo touch /etc/sudoers.d/udmrt.cfg
sudo echo "udmrt precision1 =NOPASSWD: /usr/bin/systemctl poweroff,/usr/bin/systemctl halt,/usr/bin/systemctl reboot" >> /etc/sudoers.d/udmrt.cfg
sudo echo "udmrt precision1 =NOPASSWD: /sbin/poweroff" >> /etc/sudoers.d/udmrt.cfg
sudo chmod 0440 /etc/sudoers.d/udmrt.cfg

# Setup GPIO control for startup
echo "Setting up startup led ..."
sudo echo "[gpio]" >> /boot/firmware/usercfg.txt
sudo echo "gpio=17=op,dh" >> /boot/firmware/usercfg.txt
sudo echo "gpio=26=op,dh" >> /boot/firmware/usercfg.txt

# Set flag to ensure no issues if this script is run twice
sudo echo "export UDMRT_SETUP=1" >> ~/.bashrc
fi

